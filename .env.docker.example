# ========== Docker Compose ==========
# docker-compose.yml 默认读取 .env.docker。
# 如需临时使用本示例文件校验配置，可在 PowerShell 中执行：
# $env:APP_ENV_FILE=".env.docker.example"; docker compose config; Remove-Item Env:APP_ENV_FILE
DOCKER_NETWORK=cqust-ai-net

# ========== Database ==========
# 默认连接宿主机或外部远程 MySQL。
# 若 MySQL 也在同一 Docker 网络内，可改为对应服务名，例如 mysql。
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=ptadatabase

# ========== Service ==========
RECOMMENDATION_HOST_PORT=8003
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8003

# ========== Recommendation Weights ==========
WEIGHT_NEED_MATCH=0.45
WEIGHT_DIFFICULTY_FIT=0.20
WEIGHT_SUCCESS_PROB=0.15
WEIGHT_NOVELTY=0.10
WEIGHT_QUALITY=0.10
WEIGHT_REPEAT_PENALTY=0.15

# ========== BKT Parameters ==========
BKT_P_TRANSFER=0.14
BKT_P_GUESS=0.20
BKT_P_SLIP=0.10
BKT_P_INITIAL=0.30

# ========== Ebbinghaus Parameters ==========
EBBINGHAUS_S_BASE=5.0
EBBINGHAUS_S_MAX=60.0
EBBINGHAUS_S_MIN=1.0
EBBINGHAUS_ALPHA=0.12
EBBINGHAUS_BETA=0.08
EBBINGHAUS_LAMBDA=0.03
EBBINGHAUS_DELTA=0.05
EBBINGHAUS_PRACTICE_REDUCTION=12.0

# ========== Wilson Parameters ==========
WILSON_Z=1.95

# ========== Recall Ratios ==========
RECALL_WEAK_RATIO=0.60
RECALL_DIFFICULTY_RATIO=0.25
RECALL_EXPLORATION_RATIO=0.15

# ========== Feedback Score Deltas ==========
FEEDBACK_DELTA_EXPOSURE=-0.01
FEEDBACK_DELTA_CLICK=0.04
FEEDBACK_DELTA_START=0.06
FEEDBACK_DELTA_COMPLETE=0.10
FEEDBACK_DELTA_SKIP=-0.12
FEEDBACK_DELTA_DISLIKE=-0.35
FEEDBACK_RECENCY_DECAY=0.008
FEEDBACK_RECENCY_FLOOR=0.30
FEEDBACK_MAX_HISTORY=300

# ========== Diversity ==========
DIVERSITY_MAX_TAG_RATIO=0.40
DIVERSITY_MIN_CANDIDATE_MULTIPLIER=3
